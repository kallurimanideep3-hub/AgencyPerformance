	column premium_usd
		dataType: double
		lineageTag: 9a92230c-e98a-4825-b976-7fb41fee5d35
		summarizeBy: sum
		sourceColumn: premium_usd

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Issue Year' =
			
			LOOKUPVALUE(
			    dim_date[year],
			    dim_date[date_key],
			    fact_persistency[issue_date_key]
			)
		formatString: 0
		lineageTag: 219924e9-1e2a-4825-902f-e438eb95e893
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Renewal Year' =
			
			LOOKUPVALUE(
			    dim_date[year],
			    dim_date[date_key],
			    fact_persistency[renewal_due_date_key]
			)
		formatString: 0
		lineageTag: 6e38d235-8baa-495e-ba00-27f8cfb0b173
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition fact_persistency = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Mac\Home\Documents\AgencyPerformance\fact_persistency.csv"), [Delimiter = ",", Columns = 7, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"policy_id", Int64.Type}, {"agent_id", Int64.Type}, {"product_id", Int64.Type}, {"issue_date_key", Int64.Type}, {"renewal_due_date_key", Int64.Type}, {"renewal_status", type text}, {"premium_usd", type number}})
				in
				  #"Changed column type"

