table fact_persistency
	lineageTag: 298a7680-1ed4-4ead-ae76-427fea83da9c

	column policy_id
		dataType: int64
		formatString: 0
		lineageTag: 6705d4d1-3318-40ec-b3dc-adb65eddab1b
		summarizeBy: sum
